}

.cn-shp__iclass {
    font-size: 9px;
    letter-spacing: 1.1px;
    color: #71806f;
}

.cn-shp__icargo {
    font-size: 9.5px;
    color: #a8b6ac;
}

.cn-shp__main {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    margin-left: 12px;
    flex-direction: column;
}

.cn-shp__tabs {
    height: 30px;
    flex-shrink: 0;
}

.cn-shp__tab {
    height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.22);
}

.cn-shp__tab.is-first {
    margin-left: 0;
}

.cn-shp__tab:hover {
    border-color: #71806f;
}

.cn-shp__tab.is-on {
    background-color: #16412c;
    border-color: rgba(120, 184, 145, 0.55);
}

.cn-shp__tab-t {
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #a8b6ac;
    -unity-font-style: bold;
}

.cn-shp__tab.is-on .cn-shp__tab-t {
    color: #eef3ef;
}

.cn-shp__hint {
    font-size: 10px;
    color: #4a574c;
}

.cn-shp__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 8px;
}

.cn-shp__content {
    flex-direction: column;
    padding-right: 10px;
}

.cn-shp__ohead {
    height: 22px;
    flex-shrink: 0;
}

.cn-shp__oname {
    font-size: 15px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-shp__oclass {
    height: 16px;
    margin-left: 8px;
    padding: 0 5px 0 5px;
    font-size: 9.5px;
    letter-spacing: 1.33px;
    color: #71806f;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.28);
    border-radius: 1px;
}

.cn-shp__oeng {
    margin-left: 10px;
}

.cn-shp__lamp {
    width: 7px;
    height: 7px;
    margin-right: 5px;
    border-radius: 4px;
}

.cn-shp__oengt {
    font-size: 9.5px;
    letter-spacing: 1.33px;
    color: #a8b6ac;
}

.cn-shp__oengt--off {
    color: #71806f;
}

.cn-shp__cells {
    margin-top: 10px;
    flex-shrink: 0;
}

.cn-shp__cell {
    flex-direction: column;
    min-width: 0;
    margin-left: 8px;
    padding: 4px 9px 5px 9px;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.7);
    border-radius: 2px;
}

.cn-shp__cell.is-first {
    margin-left: 0;
}

.cn-shp__cellk {
    font-size: 9px;
    letter-spacing: 1.08px;
    color: #71806f;
    white-space: nowrap;
}

.cn-shp__cellv {
    font-size: 13px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-shp__drow {
    height: 20px;
    flex-shrink: 0;
}

.cn-shp__dk {
    font-size: 10.5px;
    color: #71806f;
}

.cn-shp__dv {
    font-size: 12px;
    color: #eef3ef;
    white-space: nowrap;
}

.cn-shp__acts {
    margin-top: 10px;
    flex-shrink: 0;
}

.cn-shp__acts > .cn-tag {
    margin-left: 8px;
}

.cn-shp__acts > .cn-tag.is-first {
    margin-left: 0;
}

.cn-shp__mrow {
    height: 32px;
    flex-shrink: 0;
    margin-top: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.55);
}

.cn-shp__mrow.is-first {
    margin-top: 0;
}

.cn-shp__mrow.is-empty {
    border-color: rgba(74, 87, 76, 0.3);
}

.cn-shp__mslot {
    width: 96px;
    flex-shrink: 0;
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #71806f;
}

.cn-shp__mname {
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    color: #eef3ef;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-shp__mrow.is-empty .cn-shp__mname {
    color: #71806f;
}

.cn-shp__mpower {
    flex-shrink: 0;
    font-size: 10.5px;
    color: #a8b6ac;
    white-space: nowrap;
}

.cn-shp__crow {
    height: 28px;
    flex-shrink: 0;
    margin-top: 2px;
    padding-left: 10px;
    padding-right: 10px;
}

.cn-shp__crow.is-first {
    margin-top: 0;
}

.cn-shp__crow:hover {
    background-color: rgba(31, 38, 32, 0.6);
}

.cn-shp__cq {
    width: 42px;
    flex-shrink: 0;
    font-size: 11.5px;
    color: #eef3ef;
    -unity-font-style: bold;
}

.cn-shp__cname {
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-shp__cw {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 11px;
    color: #71806f;
    white-space: nowrap;
}

.cn-shp__cact {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #78b891;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-shp__cact.is-blocked {
    color: #4a574c;
}

.cn-shp__empty {
    font-size: 12px;
    color: #a8b6ac;
}

.cn-shp__note {
    margin-top: 8px;
    font-size: 10px;
    color: #4a574c;
    white-space: normal;
}

/* ======================= багаж игрока и трюм ======================= */

.cn-bgp {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.cn-bgp__focus {
    height: 28px;
    flex-shrink: 0;
    overflow: hidden;
}

.cn-bgp__ftag {
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.22);
}

.cn-bgp__ftag.is-first {
    margin-left: 0;
}

.cn-bgp__ftag:hover {
    border-color: #71806f;
}

.cn-bgp__ftag.is-on {
    background-color: #16412c;
    border-color: rgba(120, 184, 145, 0.55);
}

.cn-bgp__ftag-t {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #a8b6ac;
}

.cn-bgp__ftag.is-on .cn-bgp__ftag-t {
    color: #eef3ef;
}

.cn-bgp__head {
    height: 22px;
    flex-shrink: 0;
    margin-top: 6px;
}

.cn-bgp__sum {
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    letter-spacing: 1.2px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-bgp__zone {
    font-size: 10.5px;
    color: #71806f;
}

.cn-bgp__zone--on {
    color: #b9915a;
}

.cn-bgp__sorts {
    height: 24px;
    flex-shrink: 0;
    margin-top: 4px;
}

.cn-bgp__sortk {
    margin-right: 8px;
    font-size: 9.5px;
    letter-spacing: 1.4px;
    color: #4a574c;
}

.cn-bgp__stab {
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 4px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-bgp__stab:hover {
    border-color: #71806f;
}

.cn-bgp__stab.is-on {
    border-color: rgba(120, 184, 145, 0.6);
}

.cn-bgp__stab-t {
    font-size: 9.5px;
    letter-spacing: 1.1px;
    color: #71806f;
}

.cn-bgp__stab.is-on .cn-bgp__stab-t {
    color: #eef3ef;
}

.cn-bgp__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-bgp__rows {
    flex-direction: column;
}

.cn-bgp__row {
    height: 30px;
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(96, 150, 116, 0.10);
}

.cn-bgp__row:hover {
    background-color: #121711;
}

.cn-bgp__name {
    flex-shrink: 1;
    min-width: 0;
    font-size: 12.5px;
    color: #eef3ef;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-bgp__type {
    flex-shrink: 0;
    width: 110px;
    margin-left: 10px;
    font-size: 10.5px;
    color: #71806f;
}

.cn-bgp__q {
    flex-shrink: 0;
    width: 64px;
    font-size: 11.5px;
    color: #eef3ef;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.cn-bgp__w {
    flex-shrink: 0;
    width: 84px;
    margin-left: 8px;
    font-size: 11px;
    color: #a8b6ac;
    -unity-text-align: middle-right;
}

.cn-bgp__act {
    flex-shrink: 0;
    width: 78px;
    margin-left: 12px;
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #78b891;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.cn-bgp__act.is-blocked {
    color: #4a574c;
}

.cn-bgp__empty {
    padding: 14px 12px 14px 12px;
    font-size: 12px;
    color: #71806f;
}
