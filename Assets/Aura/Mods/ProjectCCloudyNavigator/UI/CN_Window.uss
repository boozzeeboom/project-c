/* Cloudy Navigator — USS окна по src/style.css, src/alt.css и стилям src/ships.js / src/calendar.js мода.
 *
 * Правила платформы (04 §1): нет filter/cursor/box-shadow/outline/::before/::after, grid и gap (зазор — margin
 * ребёнка + .is-first), z-index (порядок = порядок детей), clamp/calc/vh/vw, @keyframes, text-transform.
 * letter-spacing — в px (em мода × размер шрифта). Полупрозрачные ЗАЛИВКИ ставит код через ProjectCMainMenuGamma
 * (Linear); здесь — только непрозрачная типографика и волоски/рамки.
 *
 * Панель — ConstantPixelSize, scale 1: 1 px рамки = 1 физический пиксель, пороги раскладки мода (760/920/1200 px)
 * считаются от настоящей ширины экрана.
 */

/* ---------------------------------------------------------------- корень */

.cn-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: stretch;
}

/* Тема UnityDefaultRuntimeTheme даёт Label поля и отступы: подпись 11 px занимала 22 px. Сбрасываем классом самой
 * подписи (.cn-l ставит CnStyle.Label) — та же специфичность, что у классов ниже, поэтому их margin/padding побеждают
 * по порядку в файле; селектор «.cn-root Label» был бы сильнее и стирал бы их. */
.cn-l {
    margin: 0;
    padding: 0;
    -unity-paragraph-spacing: 0;
}

.cn-grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ---------------------------------------------------------------- станция (#home, home.js) */

.cn-station {
    flex-shrink: 0;
    flex-direction: column;
    padding: 10px 10px 0 10px;
    border-right-width: 1px;
    border-right-color: rgba(141, 122, 78, 0.35);
    overflow: hidden;
}

.cn-station > * {
    margin-top: 8px;
    flex-shrink: 0;
}

.cn-station > .cn-home__kicker {
    margin-top: 0;
}

.cn-home__kicker {
    font-size: 10px;
    letter-spacing: 2px;
    color: #71806f;
}

/* прибор-календарь */
.cn-cal {
    padding: 3px 6px 4px 6px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.22);
    border-radius: 2px;
}

.cn-cal__k {
    font-size: 9px;
    letter-spacing: 1.2px;
    color: #71806f;
    -unity-font-style: bold;
}

.cn-cal__date {
    margin-top: 1px;
    font-size: 12.5px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: normal;
}

.cn-cal__week {
    margin-top: 3px;
}

.cn-cal__cell {
    flex-grow: 1;
    flex-basis: 0;
    height: 15px;
    margin-left: 2px;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.6);
    border-radius: 1px;
}

.cn-cal__cell.is-first {
    margin-left: 0;
}

.cn-cal__cell--today {
    border-color: #54a373;
}

.cn-cal__foot {
    margin-top: 2px;
}

.cn-cal__time {
    font-size: 9.5px;
    color: #71806f;
}

.cn-cal__count {
    font-size: 9px;
    letter-spacing: 0.7px;
    color: #8d7a4e;
}

/* характеристики */
.cn-stat {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding: 3px 0 3px 0;
    margin-left: 4px;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.7);
    border-radius: 2px;
}

.cn-stat.is-first {
    margin-left: 0;
}

.cn-stat__k {
    font-size: 10px;
    letter-spacing: 0.8px;
    color: #71806f;
}

.cn-stat__v {
    font-size: 15px;
    color: #eef3ef;
    -unity-font-style: bold;
}

/* кольцо слотов: 36 | ниша + кредиты | 36 */
.cn-fig {
    height: 200px;
}

.cn-col {
    width: 36px;
    flex-shrink: 0;
    flex-direction: column;
}

.cn-cent {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 6px;
    margin-right: 6px;
    flex-direction: column;
}

.cn-slot {
    width: 36px;
    height: 36px;
    margin-top: 5px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.9);
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.cn-slot.is-first {
    margin-top: 0;
}

.cn-slot--empty {
    border-color: rgba(74, 87, 76, 0.55);
}

.cn-slot:hover {
    border-color: #a8b6ac;
}

.cn-slot__t {
    font-size: 8px;
    letter-spacing: 0.4px;
    color: #eef3ef;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.cn-slot--empty .cn-slot__t {
    color: #4a574c;
}

.cn-niche {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.cn-hp {
    height: 14px;
    flex-shrink: 0;
}

.cn-hp__k {
    font-size: 9px;
    letter-spacing: 1px;
    color: #71806f;
    -unity-font-style: bold;
}

.cn-hp__v {
    font-size: 10px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-hp__bar {
    height: 3px;
    margin-top: 2px;
    flex-shrink: 0;
    border-radius: 1px;
    overflow: hidden;
}

.cn-hp__fill {
    height: 3px;
    background-color: #54a373;
}

.cn-niche__fig {
    flex-grow: 1;
    min-height: 0;
    margin-top: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.cn-cr {
    height: 28px;
    flex-shrink: 0;
    margin-top: 4px;
    padding: 0 4px 0 4px;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.7);
    border-radius: 2px;
    overflow: hidden;
}

.cn-cr__k {
    font-size: 9px;
    letter-spacing: 1.2px;
    color: #71806f;
    white-space: nowrap;
}

.cn-cr__v {
    font-size: 14px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* модули I–III */
.cn-mods {
    justify-content: center;
}

.cn-station .cn-slot--mod {
    margin-top: 0;
    margin-left: 6px;
}

.cn-station .cn-slot--mod.is-first {
    margin-left: 0;
}

/* навыки: шесть слотов быстрого доступа и вход в социальный граф */
.cn-skills {
    flex-shrink: 0;
    flex-direction: column;
    margin-top: 6px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(96, 150, 116, 0.18);
}

.cn-skills__head {
    height: 14px;
    flex-shrink: 0;
}

.cn-skills__t {
    font-size: 10px;
    letter-spacing: 2px;
    color: #71806f;
    -unity-font-style: bold;
}

.cn-skills__n {
    font-size: 10px;
    color: #8d7a4e;
}

.cn-skills__grid {
    width: 120px;
    height: 78px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    align-self: center;
    margin-top: 4px;
    flex-shrink: 0;
}

.cn-skl {
    width: 36px;
    height: 36px;
    margin-right: 6px;
    margin-bottom: 6px;
    flex-shrink: 0;
    border-width: 1px;
    border-radius: 2px;
    border-color: rgba(74, 87, 76, 0.9);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* сетка 3 × 36 + 2 × 6 = 120: зазор — поле плитки, поэтому крайние в ряду его не держат */
.cn-skl.cn-skl--row-end {
    margin-right: 0;
}

.cn-skl.cn-skl--row-last {
    margin-bottom: 0;
}

.cn-skl__c {
    font-size: 8px;
    letter-spacing: 0.6px;
    color: #71806f;
    -unity-font-style: bold;
}

.cn-skl__n {
    font-size: 9px;
    color: #eef3ef;
}

.cn-skl--empty .cn-skl__c {
    color: #4a574c;
}

.cn-skl--empty .cn-skl__n {
    display: none;
}

.cn-skl.is-cd {
    border-color: #b9915a;
}

.cn-skl.is-cd .cn-skl__n {
    color: #b9915a;
}

.cn-skl:hover {
    border-color: #a8b6ac;
}

.cn-skills__btn {
    height: 32px;
    margin-top: 6px;
    padding-left: 4px;
    padding-right: 4px;
    border-width: 1px;
    border-radius: 2px;
    border-color: rgba(96, 150, 116, 0.28);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.cn-skills__btn-t {
    font-size: 10.5px;
    letter-spacing: 1.4px;
    color: #a8b6ac;
    -unity-font-style: bold;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* тесная ступень: подпись бирки сжимается разрядкой и кеглем, но остаётся в одну строку */
.cn-root.is-narrow .cn-skills__btn-t {
    font-size: 10px;
    letter-spacing: 0.8px;
}

.cn-skills__btn:hover {
    border-color: #78b891;
}

.cn-skills__btn:hover .cn-skills__btn-t {
    color: #eef3ef;
}

/* репутация — последний гибкий блок */
.cn-station > .cn-rel {
    flex-grow: 1;
    flex-shrink: 1;
}

.cn-rel {
    min-height: 72px;
    flex-direction: column;
    padding-top: 6px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: rgba(96, 150, 116, 0.18);
    overflow: hidden;
}

.cn-rel__head {
    height: 14px;
    flex-shrink: 0;
}

.cn-rel__t {
    font-size: 10px;
    letter-spacing: 2px;
    color: #71806f;
    -unity-font-style: bold;
}

.cn-rel__n {
    font-size: 10px;
    color: #8d7a4e;
}

.cn-rel__rows {
    flex-grow: 1;
    flex-direction: column;
    margin-top: 4px;
}

.cn-rep {
    height: 23px;
    margin-top: 4px;
    flex-shrink: 0;
    flex-direction: column;
}

.cn-rep.is-first {
    margin-top: 0;
}

.cn-rep__top {
    height: 16px;
}

.cn-rep__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    color: #eef3ef;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-rep__tier {
    font-size: 9px;
    letter-spacing: 0.6px;
    margin-left: 4px;
    white-space: nowrap;
    flex-shrink: 0;
}

.cn-rep__val {
    min-width: 26px;
    margin-left: 5px;
    font-size: 11px;
    color: #eef3ef;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.cn-rep__bar {
    height: 3px;
    margin-top: 3px;
    border-radius: 1px;
}

.cn-rep__mid {
    position: absolute;
    left: 50%;
    top: -1px;
    width: 1px;
    height: 5px;
    background-color: #71806f;
}

.cn-rep__fill {
    position: absolute;
    top: 0;
    height: 3px;
}

.cn-rel__empty,
.cn-rel__more {
    font-size: 10.5px;
    color: #71806f;
}

/* ---------------------------------------------------------------- средняя колонка */

.cn-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

/* шапка (#hdr) */
.cn-hdr {
    flex-shrink: 0;
    padding: 8px 16px 8px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(141, 122, 78, 0.28);
}

.cn-hdr__lt {
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    letter-spacing: 0.24px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-hdr__key {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 11px;
    letter-spacing: 0.44px;
    color: #71806f;
    white-space: nowrap;
}

.cn-now {
    margin-top: 3px;
}

.cn-now__k {
    flex-shrink: 0;
    margin-right: 8px;
    font-size: 13px;
    letter-spacing: 0.8px;
    color: #78b891;
    -unity-font-style: bold;
}

.cn-now__t {
    flex-shrink: 1;
    min-width: 0;
    font-size: 17px;
    color: #eef3ef;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-now__tail {
    flex-shrink: 0;
    font-size: 17px;
    color: #c98a4b;
    white-space: nowrap;
}

.cn-now__tail--alarm {
    color: #e08a72;
}

/* ---------------------------------------------------------------- лента (#lines, lines.js) */

.cn-lines {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.cn-rows {
    flex-direction: column;
    padding: 6px 0 4px 0;
}

.cn-ln {
    height: 108px;
    flex-shrink: 0;
}

.cn-ln__hair {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background-color: rgba(74, 87, 76, 0.22);
}

.cn-ln__rope {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cn-ln__title {
    position: absolute;
    left: 8px;
    right: 10px;
    top: 4px;
    height: 20px;
    padding-left: 9px;
    border-left-width: 3px;
}

.cn-ln__name {
    flex-shrink: 0;
    font-size: 15px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-rows.is-narrow .cn-ln__name {
    font-size: 14px;
}

.cn-ln__tag {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 12px;
    font-size: 11px;
    letter-spacing: 0.44px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-ln__follow {
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #b9915a;
    -unity-font-style: bold;
}

/* станция-шаг */
.cn-st {
    position: absolute;
    flex-direction: column;
    align-items: center;
}

.cn-st__name {
    max-width: 100%;
    font-size: 13px;
    color: #eef3ef;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-st__sub {
    max-width: 100%;
    font-size: 12px;
    color: #a8b6ac;
    -unity-text-align: upper-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-st--done .cn-st__name {
    color: #a8b6ac;
}

.cn-st--done .cn-st__sub {
    color: #71806f;
}

.cn-st--next .cn-st__name {
    color: #ffffff;
}

.cn-st--todo .cn-st__name {
    color: #a8b6ac;
}

.cn-st__node {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
}

.cn-st:hover .cn-st__node {
    scale: 1.08 1.08;
}

.cn-st__glyph {
    font-size: 11px;
    color: #a8b6ac;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cn-st--cur .cn-st__glyph,
.cn-st--next .cn-st__glyph {
    color: #eef3ef;
}

.cn-st--done .cn-st__glyph {
    color: #78b891;
}

.cn-st__open {
    position: absolute;
    left: -8px;
    top: -8px;
    right: -8px;
    bottom: -8px;
    border-width: 2px;
    border-color: #eef3ef;
    border-radius: 24px;
}

/* терминал награды */
.cn-end {
    position: absolute;
    flex-direction: column;
}

.cn-end__big {
    font-size: 15px;
    color: #eef3ef;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-end__small {
    font-size: 12px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-end--alarm .cn-end__small {
    color: #e08a72;
    -unity-font-style: bold;
}

.cn-end__node {
    position: absolute;
    width: 26px;
    height: 26px;
    border-width: 2px;
    border-radius: 2px;
}

.cn-end__fill {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    border-radius: 1px;
}

/* каретка */
.cn-car__pulley {
    position: absolute;
    width: 6px;
    height: 6px;
    border-width: 1px;
    border-color: #a8b6ac;
    border-radius: 3px;
    background-color: #070a09;
}

.cn-car {
    position: absolute;
    width: 16px;
    height: 12px;
    border-width: 1px;
    border-radius: 2px;
}

/* приборная бирка (.ln-act / .pin-btn) */
.cn-tag {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 32px;
    min-width: 96px;
    padding: 0 14px 0 14px;
    overflow: hidden;
}

.cn-ln__act {
    position: absolute;
}

.cn-tag__plate {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.28);
    border-radius: 1px;
}

.cn-tag__riv {
    position: absolute;
    top: 14px;
    width: 4px;
    height: 4px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.45);
    border-radius: 2px;
    background-color: #090e0b;
}

.cn-tag__riv--a {
    left: 5px;
}

.cn-tag__riv--b {
    right: 5px;
}

.cn-tag__v {
    flex-shrink: 0;
    font-size: 10.5px;
    letter-spacing: 1.47px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-tag__sep {
    width: 1px;
    margin: 4px 10px 4px 10px;
    align-self: stretch;
    background-color: rgba(96, 150, 116, 0.22);
}

.cn-tag__x {
    flex-shrink: 1;
    min-width: 0;
    font-size: 10.5px;
    letter-spacing: 1.47px;
    color: #eef3ef;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-tag--solo {
    justify-content: center;
}

.cn-tag:hover .cn-tag__plate {
    border-color: #78b891;
}

.cn-tag:active {
    translate: 0 1px;
}

.cn-tag--brass .cn-tag__plate {
    border-color: rgba(185, 145, 90, 0.6);
}

.cn-tag--danger .cn-tag__plate {
    border-color: rgba(150, 78, 62, 0.75);
}

.cn-tag--danger .cn-tag__v,
.cn-tag--danger .cn-tag__x {
    color: #a8b6ac;
}

.cn-tag--danger:hover .cn-tag__plate {
    border-color: rgba(190, 96, 76, 0.95);
}

.cn-tag--danger:hover .cn-tag__v {
    color: #d0705a;
}

.cn-tag--off .cn-tag__plate {
    border-color: rgba(96, 150, 116, 0.24);
    border-left-color: rgba(168, 182, 172, 0.72);
}

.cn-tag--off .cn-tag__v,
.cn-tag--off .cn-tag__x {
    color: #a8b6ac;
}

.cn-ln__info {
    position: absolute;
    font-size: 12.5px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* карточка шага (.ln-card) */
.cn-card {
    flex-shrink: 0;
    flex-direction: column;
    margin: 2px 8px 10px 8px;
    padding: 10px 14px 12px 14px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.4);
    border-radius: 2px;
}

.cn-card__arrow {
    position: absolute;
    top: -7px;
    width: 12px;
    height: 12px;
    rotate: 45deg;
    border-left-width: 1px;
    border-top-width: 1px;
    border-color: rgba(96, 150, 116, 0.6);
    background-color: #16412c;
}

.cn-card__head {
    margin-bottom: 8px;
}

.cn-card__b {
    flex-shrink: 0;
    font-size: 13px;
    color: #eef3ef;
    -unity-font-style: bold;
}

.cn-card__h {
    flex-shrink: 1;
    min-width: 0;
    font-size: 13px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-card__grid {
    align-items: flex-start;
}

.cn-card__cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 16px;
    flex-direction: column;
}

.cn-card__cell.is-first {
    margin-left: 0;
}

.cn-card__k {
    font-size: 10.5px;
    letter-spacing: 1.26px;
    color: #71806f;
}

.cn-card__v {
    margin-top: 2px;
    font-size: 13px;
    color: #eef3ef;
    white-space: normal;
}

.cn-card__v--good {
    color: #78b891;
}

.cn-card__acts {
    margin-top: 10px;
}

.cn-card__acts > .cn-tag {
    margin-left: 6px;
}

.cn-card__acts > .cn-tag.is-first {
    margin-left: 0;
}

.cn-lines__empty {
    flex-direction: column;
    padding: 18px 16px 18px 16px;
}

.cn-lines__empty-t {
    font-size: 11.5px;
    letter-spacing: 2.3px;
    color: #78b891;
    -unity-font-style: bold;
}

.cn-lines__empty-s {
    margin-top: 4px;
    font-size: 12px;
    color: #71806f;
}

/* ---------------------------------------------------------------- док КОРАБЛЬ | БАГАЖ */

.cn-dock {
    flex-shrink: 0;
    height: 96px;
    min-height: 96px;
    border-top-width: 1px;
    border-top-color: rgba(141, 122, 78, 0.4);
}

.cn-ships,
.cn-bag {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.cn-bag {
    border-left-width: 1px;
    border-left-color: rgba(185, 145, 90, 0.45);
}

.cn-dock__head {
    height: 32px;
    flex-shrink: 0;
    padding: 0 12px 0 12px;
}

.cn-dock__t {
    flex-shrink: 0;
    font-size: 11.5px;
    letter-spacing: 2.3px;
    color: #78b891;
    -unity-font-style: bold;
}

.cn-dock__hint {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 10px;
    font-size: 11px;
    color: #71806f;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-dock__hint--zone {
    color: #b9915a;
}

.cn-dock__sum {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 10.5px;
    letter-spacing: 1.26px;
    color: #a8b6ac;
    white-space: nowrap;
}

.cn-dock__empty {
    font-size: 11.5px;
    color: #71806f;
}

.cn-ships__body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    padding: 0 12px 6px 12px;
    overflow: hidden;
}

.cn-sh__main {
    height: 19px;
    flex-shrink: 0;
}

.cn-sh__name {
    flex-shrink: 1;
    min-width: 0;
    font-size: 15px;
    color: #eef3ef;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-sh__class {
    flex-shrink: 0;
    height: 16px;
    margin-left: 8px;
    padding: 0 5px 0 5px;
    font-size: 9.5px;
    letter-spacing: 1.33px;
    color: #71806f;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.28);
    border-radius: 1px;
}

.cn-sh__eng {
    flex-shrink: 0;
    margin-left: 8px;
}

.cn-sh__lamp {
    width: 7px;
    height: 7px;
    margin-right: 5px;
    border-radius: 4px;
}

.cn-sh__engt {
    font-size: 9.5px;
    letter-spacing: 1.33px;
    color: #a8b6ac;
    white-space: nowrap;
}

.cn-sh__engt--off {
    color: #71806f;
}

.cn-sh__grid {
    flex-shrink: 0;
    margin-top: 4px;
}

.cn-sh__cell {
    flex-direction: column;
    min-width: 0;
    margin-left: 6px;
    padding: 2px 7px 3px 7px;
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.7);
    border-radius: 2px;
}

.cn-sh__cell.is-first {
    margin-left: 0;
}

.cn-sh__k {
    font-size: 9px;
    letter-spacing: 1.08px;
    color: #71806f;
    white-space: nowrap;
}

.cn-sh__v {
    font-size: 12px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-sh__crow {
    height: 15px;
    flex-shrink: 0;
    margin-top: 1px;
    font-size: 10.5px;
    color: #a8b6ac;
}

.cn-sh__crow:hover {
    background-color: rgba(31, 38, 32, 0.6);
}

.cn-sh__crow--empty,
.cn-sh__crow--more {
    margin-top: 5px;
    color: #71806f;
}

.cn-sh__cq {
    min-width: 28px;
    font-size: 10.5px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-sh__cn {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 6px;
    font-size: 10.5px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-sh__crow.is-blocked .cn-sh__cn,
.cn-sh__crow.is-blocked .cn-sh__cq {
    color: #71806f;
}

.cn-sh__cw {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10.5px;
    color: #71806f;
    white-space: nowrap;
}

.cn-bag__strip {
    flex-grow: 1;
    min-height: 0;
    padding: 0 12px 6px 12px;
    overflow: hidden;
}

.cn-tile,
.cn-bag__more {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-left: 6px;
    margin-top: 6px;
    border-width: 1px;
    border-radius: 2px;
}

.cn-tile {
    flex-direction: column;
    padding: 4px 4px 2px 5px;
    border-color: rgba(74, 87, 76, 0.9);
    overflow: hidden;
}

.cn-tile.is-line-first,
.cn-bag__more.is-line-first {
    margin-left: 0;
}

.cn-tile.is-first-line,
.cn-bag__more.is-first-line {
    margin-top: 0;
}

.cn-tile:hover {
    border-color: #a8b6ac;
}

.cn-tile.is-blocked {
    border-color: rgba(74, 87, 76, 0.5);
}

.cn-tile__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    font-size: 9.5px;
    color: #eef3ef;
    white-space: normal;
    overflow: hidden;
}

.cn-tile.is-blocked .cn-tile__name {
    color: #a8b6ac;
}

.cn-tile__q {
    flex-shrink: 0;
    font-size: 11px;
    color: #eef3ef;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
}

.cn-bag__more {
    align-items: center;
    justify-content: center;
    border-color: rgba(96, 150, 116, 0.5);
}

.cn-bag__moret {
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #a8b6ac;
    -unity-font-style: bold;
}

/* узкий док (.dock-narrow мода): подсказки и бирка класса прячутся, ячейки в один ряд */
.cn-root.is-dock-narrow .cn-dock__hint,
.cn-root.is-dock-narrow .cn-sh__class {
    display: none;
}

.cn-root.is-dock-narrow .cn-dock__head {
    padding: 0 8px 0 8px;
}

.cn-root.is-dock-narrow .cn-ships__body,
.cn-root.is-dock-narrow .cn-bag__strip {
    padding: 0 8px 5px 8px;
}

.cn-root.is-dock-narrow .cn-sh__cell {
    flex-grow: 1;
    flex-basis: 0;
    padding: 2px 4px 3px 4px;
}

/* ---------------------------------------------------------------- шкала высоты (#altrail, alt.css) */

.cn-altrail {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    border-left-width: 1px;
    border-left-color: rgba(141, 122, 78, 0.3);
    overflow: hidden;
}

.cn-ar__dot {
    flex-shrink: 0;
    align-self: center;
    width: 16px;
    height: 16px;
    margin-top: 10px;
    border-width: 1px;
    border-color: #78b891;
    border-radius: 8px;
    font-size: 9px;
    color: #78b891;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cn-ar__dot--danger {
    border-color: #e08a72;
    color: #e08a72;
}

.cn-ar__scale {
    flex-grow: 1;
    min-height: 40px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.cn-ar__ticks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cn-ar__tk {
    position: absolute;
    height: 1px;
    background-color: rgba(120, 184, 145, 0.55);
}

.cn-ar__tk--out {
    background-color: rgba(194, 91, 69, 0.42);
}

.cn-ar__cor {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: #78b891;
}

.cn-ar__cc {
    position: absolute;
    top: -1px;
    width: 3px;
    height: 3px;
    background-color: #78b891;
}

.cn-ar__mark {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
}

.cn-ar__v {
    font-size: 11px;
    color: #eef3ef;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.cn-ar__hair {
    width: 100%;
    height: 1px;
    margin-top: 2px;
    background-color: rgba(201, 162, 39, 0.6);
}

/* ---------------------------------------------------------------- слой движения */

.cn-motion {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Классы переиспользованных слоёв меню: пуфы позиционируются кодом (CnMotion), здесь только рамка слоя. */
.cn-motion .pc-smoke-field,
.cn-motion .pc-ghost-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cn-motion .pc-smoke-puff {
    position: absolute;
}

.cn-motion .pc-ghost {
    position: absolute;
    overflow: visible;
}

/* ---------------------------------------------------------------- полноразмерные попапы (v4-2) */

.cn-pop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cn-pop__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cn-pop__win {
    position: absolute;
    left: 18px;
    top: 18px;
    right: 18px;
    bottom: 18px;
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.34);
}

.cn-pop__head {
    height: 44px;
    padding-left: 16px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(96, 150, 116, 0.22);
    flex-shrink: 0;
}

.cn-pop__title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #eef3ef;
    letter-spacing: 2.2px;
}

.cn-pop__sub {
    font-size: 11px;
    color: #71806f;
    margin-left: 12px;
    letter-spacing: 1.1px;
}

.cn-pop__x {
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.28);
}

.cn-pop__x:hover {
    border-color: #a8b6ac;
}

.cn-pop__x-t {
    font-size: 12px;
    color: #a8b6ac;
    -unity-text-align: middle-center;
}

.cn-pop__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 12px;
}

/* ---------------------------------------------------------------- окно «ЗАДАНИЯ» */

.cn-qp {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.cn-qp__tabs {
    height: 30px;
    flex-shrink: 0;
}

.cn-qp__tab {
    height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.20);
}

.cn-qp__tab:hover {
    border-color: #71806f;
}

.cn-qp__tab.is-on {
    background-color: #16412c;
    border-color: rgba(120, 184, 145, 0.55);
}

.cn-qp__tab-t {
    font-size: 10px;
    color: #a8b6ac;
    letter-spacing: 1.3px;
    white-space: nowrap;
}

.cn-qp__tab.is-on .cn-qp__tab-t {
    color: #eef3ef;
}

.cn-qp__hint {
    font-size: 10px;
    color: #4a574c;
}

.cn-qp__filters {
    height: 26px;
    margin-top: 6px;
    flex-shrink: 0;
}

.cn-qp__zone {
    font-size: 10px;
    color: #71806f;
    letter-spacing: 1px;
}

.cn-qp__cols {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
    margin-top: 8px;
}

.cn-qp__list {
    width: 54%;
    min-width: 0;
    min-height: 0;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-qp__rows {
    flex-direction: column;
}

.cn-qrow {
    height: 44px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(96, 150, 116, 0.12);
}

.cn-qrow--contract {
    height: 48px;
}

.cn-qrow:hover {
    background-color: #121711;
}

.cn-qrow.is-selected {
    background-color: #1f2620;
}

.cn-qrow__g {
    width: 16px;
    font-size: 11px;
    color: #78b891;
    flex-shrink: 0;
}

.cn-qrow__t {
    font-size: 12px;
    color: #eef3ef;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cn-qrow__stack {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
}

.cn-qrow__sub {
    font-size: 10px;
    color: #71806f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cn-qrow__follow {
    font-size: 9px;
    color: #b9915a;
    margin-left: 8px;
    letter-spacing: 1.1px;
    flex-shrink: 0;
}

.cn-qrow__n {
    font-size: 11px;
    color: #a8b6ac;
    margin-left: 10px;
    flex-shrink: 0;
}

.cn-qrow__s {
    font-size: 10px;
    color: #71806f;
    margin-left: 10px;
    width: 64px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.cn-qrow__s--alarm {
    color: #e08a72;
}

.cn-qp__empty {
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.cn-qp__empty-t {
    font-size: 11px;
    color: #a8b6ac;
    letter-spacing: 1.4px;
}

.cn-qp__empty-s {
    font-size: 10px;
    color: #71806f;
    margin-top: 4px;
    white-space: normal;
}

.cn-qp__det {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    margin-left: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-qp__det-title {
    font-size: 15px;
    color: #eef3ef;
    white-space: normal;
}

.cn-qp__det-meta {
    height: 22px;
    margin-top: 4px;
    flex-shrink: 0;
}

.cn-qp__det-state {
    font-size: 10px;
    color: #b9915a;
    letter-spacing: 1.2px;
    margin-right: 10px;
}

.cn-qp__det-progress {
    font-size: 10px;
    color: #a8b6ac;
    margin-right: 10px;
}

.cn-qp__det-track {
    font-size: 10px;
    color: #78b891;
    letter-spacing: 1.1px;
}

.cn-qp__goals {
    flex-direction: column;
    margin-top: 8px;
    flex-shrink: 0;
}

.cn-qp__goal {
    height: 20px;
    flex-shrink: 0;
}

.cn-qp__goal-g {
    width: 16px;
    font-size: 10px;
    color: #71806f;
    flex-shrink: 0;
}

.cn-qp__goal.is-done .cn-qp__goal-g {
    color: #78b891;
}

.cn-qp__goal-t {
    font-size: 11px;
    color: #a8b6ac;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cn-qp__goal-n {
    font-size: 10px;
    color: #71806f;
    flex-shrink: 0;
}

.cn-qp__det-k {
    font-size: 10px;
    color: #71806f;
    letter-spacing: 1.2px;
}

.cn-qp__det-v {
    font-size: 11px;
    color: #eef3ef;
}

.cn-qp__det-note {
    font-size: 10px;
    color: #71806f;
    margin-top: 8px;
    white-space: normal;
}

.cn-qp__acts {
    flex-direction: row;
    margin-top: 10px;
    flex-shrink: 0;
}

.cn-qp__det-id {
    font-size: 9px;
    color: #4a574c;
    margin-top: 6px;
}

/* ---------------------------------------------------------------- панель наведения на строке ленты */

.cn-hov {
    flex-direction: column;
    margin-left: 2px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 2px;
    border-top-width: 1px;
    border-top-color: rgba(96, 150, 116, 0.22);
    flex-shrink: 0;
}

.cn-hov__head {
    height: 18px;
    flex-shrink: 0;
}

.cn-hov__t {
    font-size: 12px;
    -unity-font-style: bold;
    color: #eef3ef;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cn-hov__tag {
    font-size: 10px;
    color: #71806f;
    margin-left: 10px;
    white-space: nowrap;
    flex-shrink: 0;
}

.cn-hov__r {
    font-size: 11px;
    color: #b9915a;
    flex-shrink: 0;
}

.cn-hov__step {
    height: 20px;
    flex-shrink: 0;
}

.cn-hov__g {
    width: 14px;
    font-size: 10px;
    color: #71806f;
    flex-shrink: 0;
}

.cn-hov__step.is-done .cn-hov__g {
    color: #78b891;
}

.cn-hov__step.is-cur .cn-hov__g {
    color: #eef3ef;
}

.cn-hov__n {
    font-size: 11px;
    color: #a8b6ac;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cn-hov__s {
    font-size: 10px;
    color: #71806f;
    flex-shrink: 0;
}

.cn-hov__acts {
    flex-direction: row;
    margin-top: 6px;
    flex-shrink: 0;
}

.cn-hov__info {
    font-size: 10px;
    color: #b9915a;
}

.cn-ln--hover {
    border-bottom-width: 0;
}

/* ======================= граф навыков ======================= */

.cn-skg {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.cn-skg__tabs {
    height: 30px;
    flex-shrink: 0;
}

.cn-skg__tab {
    height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 6px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.22);
    align-items: center;
    justify-content: center;
}

.cn-skg__tab.is-first {
    margin-left: 0;
}

.cn-skg__tab:hover {
    border-color: #71806f;
}

.cn-skg__tab.is-on {
    background-color: #16412c;
    border-color: rgba(120, 184, 145, 0.55);
}

.cn-skg__tab-t {
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #a8b6ac;
    -unity-font-style: bold;
}

.cn-skg__tab.is-on .cn-skg__tab-t {
    color: #eef3ef;
}

.cn-skg__hint {
    font-size: 10px;
    color: #4a574c;
}

.cn-skg__cols {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    margin-top: 8px;
}

.cn-skg__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.cn-skg__node {
    position: absolute;
    padding-left: 6px;
    padding-right: 6px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.38);
    overflow: hidden;
}

.cn-skg__node:hover {
    border-color: #a8b6ac;
}

.cn-skg__node.is-sel {
    border-color: #78b891;
}

.cn-skg__node.is-known {
    border-color: rgba(74, 87, 76, 0.75);
}

.cn-skg__node.is-foreign {
    border-left-width: 3px;
    border-left-color: #b9915a;
}

.cn-skg__badge {
    font-size: 10px;
    color: #71806f;
    margin-right: 5px;
    flex-shrink: 0;
}

.cn-skg__node.is-learned .cn-skg__badge {
    color: #78b891;
}

.cn-skg__title {
    font-size: 10px;
    color: #eef3ef;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cn-skg__node.is-known .cn-skg__title {
    color: #a8b6ac;
}

.cn-skg__type {
    font-size: 9px;
    color: #4a574c;
    flex-shrink: 0;
}

.cn-skg__type.is-on {
    color: #b9915a;
}

.cn-skg__det {
    width: 320px;
    flex-shrink: 0;
    min-height: 0;
    margin-left: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-skg__det-title {
    font-size: 15px;
    color: #eef3ef;
    white-space: normal;
}

.cn-skg__det-meta {
    height: 22px;
    margin-top: 4px;
    flex-shrink: 0;
}

.cn-skg__det-state {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #b9915a;
    margin-right: 10px;
}

.cn-skg__det-type {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #a8b6ac;
    margin-right: 10px;
}

.cn-skg__det-foreign {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #b9915a;
}

.cn-skg__det-row {
    height: 20px;
    flex-shrink: 0;
}

.cn-skg__det-k {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #71806f;
}

.cn-skg__det-sec {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #71806f;
    margin-top: 10px;
}

.cn-skg__det-v {
    font-size: 11px;
    color: #a8b6ac;
}

.cn-skg__det-desc {
    font-size: 11px;
    color: #a8b6ac;
    margin-top: 8px;
    white-space: normal;
}

.cn-skg__prereq {
    font-size: 11px;
    color: #71806f;
    margin-top: 2px;
    white-space: normal;
}

.cn-skg__prereq.is-on {
    color: #78b891;
}

.cn-skg__det-note {
    font-size: 10px;
    color: #4a574c;
    margin-top: 10px;
    white-space: normal;
}

.cn-skg__det-hint {
    font-size: 11px;
    color: #a8b6ac;
}

.cn-skg__acts {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin-top: 10px;
}

.cn-skg__blocked {
    font-size: 10px;
    letter-spacing: 1px;
    color: #71806f;
    white-space: normal;
}

.cn-skg__binds {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 4px;
}

.cn-skg__bind {
    height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.28);
    overflow: hidden;
}

.cn-skg__bind:hover {
    border-color: #a8b6ac;
}

.cn-skg__bind.is-on {
    border-color: #78b891;
}

.cn-skg__bind.is-taken {
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-skg__bind.is-cd {
    border-color: #b9915a;
}

.cn-skg__bind-t {
    font-size: 10px;
    letter-spacing: 1px;
    color: #a8b6ac;
}

/* ======================= кликабельные блоки станции, шапки дока и вход в задания ======================= */

.cn-clickable:hover {
    border-color: rgba(120, 184, 145, 0.55);
}

.cn-dock__head.cn-clickable:hover {
    background-color: rgba(31, 38, 32, 0.55);
}

.cn-bag__more:hover {
    border-color: #78b891;
}

.cn-hdr__tag {
    height: 24px;
    min-width: 0;
    margin-left: 12px;
    padding: 0 11px 0 11px;
}

.cn-hdr__tag .cn-tag__v {
    font-size: 9.5px;
    letter-spacing: 1.2px;
}

.cn-hdr__tag .cn-tag__riv {
    top: 10px;
}

/* ======================= календарь года ======================= */

.cn-calp {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.cn-calp__head {
    height: 26px;
    flex-shrink: 0;
}

.cn-calp__year {
    font-size: 12px;
    letter-spacing: 2px;
    color: #b9915a;
    -unity-font-style: bold;
}

.cn-calp__date {
    margin-left: 14px;
    font-size: 15px;
    color: #eef3ef;
    -unity-font-style: bold;
    white-space: nowrap;
}

.cn-calp__clock {
    margin-left: 12px;
    font-size: 13px;
    color: #a8b6ac;
    white-space: nowrap;
}

.cn-calp__rules {
    font-size: 10px;
    color: #4a574c;
    white-space: nowrap;
}

.cn-calp__cols {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 10px;
}

.cn-calp__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.cn-calp__months {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 2px;
}

.cn-calp__m {
    flex-direction: column;
    flex-shrink: 0;
    padding: 6px 6px 7px 6px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.20);
    border-radius: 2px;
}

.cn-calp__mh {
    height: 16px;
}

.cn-calp__mn {
    flex-shrink: 1;
    min-width: 0;
    font-size: 10.5px;
    color: #d3e2e6;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-calp__mi {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 9px;
    color: #4a574c;
}

.cn-calp__wh {
    margin-top: 3px;
}

.cn-calp__wd {
    font-size: 8px;
    letter-spacing: 0.4px;
    color: #4a574c;
    -unity-text-align: middle-center;
}

.cn-calp__grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.cn-calp__d {
    border-width: 1px;
    border-color: rgba(74, 87, 76, 0.5);
    border-radius: 1px;
}

.cn-calp__d--blank {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.cn-calp__d.is-today {
    border-color: #78b891;
}

.cn-calp__side {
    width: 320px;
    flex-shrink: 0;
    min-height: 0;
    margin-left: 14px;
    padding: 10px 12px 12px 12px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
    flex-direction: column;
    overflow: hidden;
}

.cn-calp__side-t {
    font-size: 10px;
    letter-spacing: 1.6px;
    color: #71806f;
    -unity-font-style: bold;
    margin-top: 10px;
}

.cn-calp__srow {
    height: 18px;
    flex-shrink: 0;
}

.cn-calp__sk {
    font-size: 10.5px;
    color: #71806f;
}

.cn-calp__sv {
    font-size: 11px;
    color: #eef3ef;
    white-space: nowrap;
}

.cn-calp__crow {
    height: 18px;
    flex-shrink: 0;
}

.cn-calp__cn {
    font-size: 11px;
    color: #a8b6ac;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cn-calp__cv {
    flex-shrink: 0;
    font-size: 11px;
    color: #eef3ef;
    -unity-font-style: bold;
}

.cn-calp__cv.is-alarm {
    color: #e08a72;
}

.cn-calp__note {
    font-size: 10px;
    color: #4a574c;
    margin-top: 8px;
    white-space: normal;
}

.cn-calp__empty {
    font-size: 12px;
    color: #71806f;
    margin: 12px 0 0 0;
}

/* ======================= отношения (фракции и люди) ======================= */

.cn-relp {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.cn-relp__head {
    height: 26px;
    flex-shrink: 0;
}

.cn-relp__title {
    font-size: 13px;
    letter-spacing: 2.2px;
    color: #eef3ef;
    -unity-font-style: bold;
}

.cn-relp__note {
    margin-left: 12px;
    font-size: 10px;
    color: #4a574c;
}

.cn-relp__count {
    font-size: 10px;
    color: #8d7a4e;
}

.cn-relp__cols {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 10px;
}

.cn-relp__col {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
}

.cn-relp__col--alt {
    margin-left: 12px;
}

.cn-relp__colhead {
    height: 28px;
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(96, 150, 116, 0.12);
}

.cn-relp__colt {
    font-size: 10px;
    letter-spacing: 1.8px;
    color: #71806f;
    -unity-font-style: bold;
}

.cn-relp__coln {
    margin-left: 8px;
    font-size: 10px;
    color: #8d7a4e;
}

.cn-relp__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.cn-relp__rows {
    flex-direction: column;
    padding: 8px 12px 10px 12px;
}

.cn-relp__row {
    height: 30px;
    flex-shrink: 0;
    margin-top: 8px;
    flex-direction: column;
}

.cn-relp__row.is-first {
    margin-top: 0;
}

.cn-relp__top {
    height: 18px;
}

.cn-relp__bar {
    height: 3px;
    margin-top: 4px;
    border-radius: 1px;
}

.cn-relp__mid {
    position: absolute;
    left: 50%;
    top: -1px;
    width: 1px;
    height: 5px;
    background-color: #71806f;
}

.cn-relp__mid--zero {
    left: 33.33%;
}

.cn-relp__empty {
    font-size: 11px;
    color: #71806f;
}

.cn-relp__footer {
    flex-shrink: 0;
    margin-top: 10px;
    font-size: 10px;
    color: #4a574c;
    white-space: normal;
}

/* ======================= окно корабля ======================= */

.cn-shp {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

.cn-shp__list {
    width: 220px;
    flex-shrink: 0;
    flex-direction: column;
    padding: 0 0 8px 0;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.16);
    overflow: hidden;
}

.cn-shp__item {
    flex-shrink: 0;
    flex-direction: column;
    margin-top: 6px;
    padding: 6px 10px 7px 10px;
    border-width: 1px;
    border-color: rgba(96, 150, 116, 0.18);
}

.cn-shp__item.is-first {
    margin-top: 0;
}

.cn-shp__item.is-sel {
    border-color: #78b891;
}

.cn-shp__item:hover {
