<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="UI/MainMenuStyles" />
    <ui:VisualElement name="main-menu-root" class="main-menu-root">
        <ui:VisualElement name="main-menu-window" class="main-menu-window">
            <!-- Title -->
            <ui:Label name="main-menu-title" text="PROJECT C: THE CLOUDS" class="main-menu-title" />
            <ui:Label name="main-menu-subtitle" text="Версия Alpha 0.1" class="main-menu-subtitle" />

            <!-- Root Menu Buttons (visible by default) -->
            <ui:VisualElement name="main-menu-buttons" class="main-menu-buttons">
                <ui:Button name="main-host-btn" text="ОДИНОЧНАЯ ИГРА" class="main-menu-btn" />
                <ui:Button name="main-connect-btn" text="ПОДКЛЮЧИТЬСЯ К СЕРВЕРУ" class="main-menu-btn" />
                <ui:Button name="main-settings-btn" text="НАСТРОЙКИ" class="main-menu-btn" />
                <ui:Button name="main-quit-btn" text="ВЫХОД" class="main-menu-btn main-menu-btn-warning" />
            </ui:VisualElement>

            <!-- IP Connect Sub-panel (hidden by default) -->
            <ui:VisualElement name="main-ip-panel" class="main-ip-panel" style="display: none;">
                <ui:Label name="main-ip-title" text="ПОДКЛЮЧЕНИЕ К СЕРВЕРУ" class="main-menu-title" />
                <ui:Label name="main-ip-label" text="Введите IP-адрес сервера:" class="main-ip-label" />
                <ui:TextField name="main-ip-field" text="" class="main-ip-field" picking-mode="Position" />
                <ui:VisualElement name="main-ip-buttons" class="main-ip-buttons">
                    <ui:Button name="main-ip-connect-btn" text="ПОДКЛЮЧИТЬСЯ" class="main-menu-btn" />
                    <ui:Button name="main-ip-back-btn" text="НАЗАД" class="main-menu-btn main-menu-btn-back" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Persistence debug tools (top-left corner) -->
        <ui:VisualElement name="main-debug-panel" class="main-debug-panel">
            <ui:Label name="main-debug-title" text="[Debug]" class="main-debug-title" />
            <ui:ScrollView name="main-debug-scroll" class="main-debug-scroll">
                <ui:Button name="main-debug-delete-all-btn" text="[Delete All Saves]" class="main-debug-btn main-debug-btn-danger" />
                <ui:Button name="main-debug-delete-position-btn" text="[Delete Character Position Saves]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-inventory-btn" text="[Delete Character Inventory]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-progression-btn" text="[Delete Character Progression]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-customisation-btn" text="[Delete Character Customisation]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-quests-btn" text="[Delete Quests]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-skills-btn" text="[Delete Skill Slot Bindings]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-keys-btn" text="[Delete Key Instance Saves]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-time-btn" text="[Delete World Time]" class="main-debug-btn" />
                <ui:Button name="main-debug-delete-trade-btn" text="[Delete Trade / Cargo Saves]" class="main-debug-btn" />
            </ui:ScrollView>
            <ui:Label name="main-debug-status" text="" class="main-debug-status" />
        </ui:VisualElement>

        <!-- Language selector (top-right corner) -->
        <ui:VisualElement name="main-lang-selector" class="main-lang-selector" />

        <!-- External links (bottom-left corner) -->
        <ui:VisualElement name="main-links" class="main-links" />
    </ui:VisualElement>
</ui:UXML>