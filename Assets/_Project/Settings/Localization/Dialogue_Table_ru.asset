    m_Metadata:
      m_Items: []
  - m_Id: 7279836971049005
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u044B\u0439
      \u043C\u0430\u043D\u0438\u0444\u0435\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836971049006
    m_Localized: "\u0421\u0435\u043B\u0430 \u2014 \u0434\u0438\u0430\u043B\u043E\u0433
      Q001"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836971049007
    m_Localized: "\u0421\u0435\u043B\u0430: \u0412\u043E\u0437\u044C\u043C\u0438
      \u044D\u0442\u043E\u0442 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442;
      \u043E\u043D \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442 \u0447\u0430\u0441\u0442\u044C
      \u0437\u0430\u043F\u0438\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836971049008
    m_Localized: "\u0421\u0435\u043B\u0430: \u0421\u0438\u0433\u043D\u0430\u043B
      \u0438\u0437 \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u043E\u0433\u043E
      \u0430\u0440\u0445\u0438\u0432\u0430 \u0441\u043D\u043E\u0432\u0430 \u0430\u043A\u0442\u0438\u0432\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836971049009
    m_Localized: "\u0421\u0435\u043B\u0430: \u041C\u043E\u0451 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043D\u0435\u043F\u043E\u043B\u043D\u043E\u0435, \u043D\u043E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
      \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836971049010
    m_Localized: "\u0421\u0435\u043B\u0430: \u0421\u0438\u0433\u043D\u0430\u043B
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u043E\u043C\u0443
      \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0443, \u0430 \u043D\u0435
      \u0432\u043E\u0435\u043D\u043D\u043E\u043C\u0443 \u043C\u0430\u044F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243264
    m_Localized: "\u0421\u0435\u043B\u0430: \u042F \u0431\u044B\u043B\u0430 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u043C
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u043E\u0433\u043E \u0430\u0440\u0445\u0438\u0432\u0430
      \u0434\u043E \u0435\u0433\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243265
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u0432\u0435\u0442\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243266
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u043D\u0435\u043F\u043E\u043B\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243267
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243268
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243269
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243270
    m_Localized: "\u0412\u0435\u0441\u043A\u0430 \u2014 \u0434\u0438\u0430\u043B\u043E\u0433
      Q001"
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243271
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u0410\u0440\u0445\u0438\u0432
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u043F\u043E\u043C\u043D\u0438\u0442,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243272
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u043D\u0430\u044F
      \u043B\u0438\u043D\u0437\u0430 \u043E\u0442\u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243273
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u041F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u0430\u044F
      \u043F\u0435\u0447\u0430\u0442\u044C \u0432\u044B\u0434\u0430\u043B\u0430 \u043E\u0431\u043C\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243274
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u041F\u0435\u0447\u0430\u0442\u044C
      \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u0430\u044F; \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0432
      \u0435\u0451, \u0442\u044B \u0441\u043E\u0440\u0432\u0451\u0448\u044C \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243275
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u0421\u0438\u0433\u043D\u0430\u043B
      \u0438\u0437 \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u043E\u0433\u043E
      \u0430\u0440\u0445\u0438\u0432\u0430 \u0441\u043D\u043E\u0432\u0430 \u0430\u043A\u0442\u0438\u0432\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243276
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u0413\u043B\u0443\u0445\u043E\u0439
      \u043C\u0430\u044F\u043A \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u0430\u0440\u0445\u0438\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243277
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u042F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E
      \u0441\u0438\u0433\u043D\u0430\u043B \u0441 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u043C
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243278
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u0421\u0438\u0433\u043D\u0430\u043B
      \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u043C
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7279836975243279
    m_Localized: "\u0412\u0435\u0441\u043A\u0430: \u0421\u0438\u0433\u043D\u0430\u043B
