  m_TableData:
  - m_Id: 178693698658304
    m_Localized: "\u041C\u0438\u0440\u0430 \u0422\u0438\u0445\u043E\u0441\u0442\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 178693832876032
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u0437\u043D\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 178693845458944
    m_Localized: "\u041C\u0438\u0440\u0430 \u2014 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 178693853847552
    m_Localized: "\u0432\u0430\u0430\u044B\u0432\u0430\u044B\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 178693862236160
    m_Localized: New Dialog
    m_Metadata:
      m_Items: []
  - m_Id: 178693870624768
    m_Localized: Hello!
    m_Metadata:
      m_Items: []
  - m_Id: 178693874819072
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C 3 \u043C\u0435\u0434\u043D\u044B\u0445
      \u0440\u0443\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 178693879013376
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 3 \u043A\u0443\u0441\u043A\u0430
      \u043C\u0435\u0434\u043D\u043E\u0439 \u0440\u0443\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517880012800
    m_Localized: Onboarding alfa
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372928
    m_Localized: "\u041E\u043D\u0431\u043E\u0440\u0434\u0438\u043D\u0433-\u0430\u043B\u044C\u0444\u0430
      \u0436\u0434\u0451\u0442 \u043D\u0430 \u043A\u0440\u044B\u0448\u0435 \u0430\u043D\u0433\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372929
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u0432\u0435\u0441\u0442-\u0433\u0430\u0439\u0434:
      \u0432\u0432\u043E\u0434\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372930
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u044B
      \u0437\u0434\u0435\u0441\u044C \u0432\u044B\u0436\u0438\u0432\u0430\u044E\u0442
      \u043D\u0435 \u0441\u0430\u043C\u044B\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0435,
      \u0430 \u0442\u0435, \u043A\u0442\u043E \u0443\u043C\u0435\u0435\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C. \u041C\u0438\u0440\u0430 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u0438
      \u0432 \u041F\u0440\u0438\u043C\u0438\u0443\u043C\u0435. \u042F \u043C\u043E\u0433\u0443
      \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0442\u0435\u0431\u044F \u043F\u043E
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443
      \u0438 \u0434\u0430\u0442\u044C \u043A\u043B\u044E\u0447 \u043E\u0442 \u043B\u0451\u0433\u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372931
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438
      \u0441 \u041C\u0438\u0440\u043E\u0439. \u0417\u0430\u0442\u0435\u043C \u0437\u0430\u0433\u043B\u044F\u043D\u0438
      \u043A RepairManager, \u0432\u0435\u0440\u043D\u0438\u0441\u044C \u043A\u043E
      \u043C\u043D\u0435? \u041D\u0435\u0442 \u2014 \u0432\u0435\u0440\u043D\u0438\u0441\u044C
      \u043A \u041C\u0438\u0440\u0435. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u044C MarketZone_Primium \u0438 \u0441\u043D\u043E\u0432\u0430
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u043A \u041C\u0438\u0440\u0435.
      \u0415\u0441\u043B\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372932
    m_Localized: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u043F\u0440\u0438\u043D\u044F\u0442.
      \u0418\u0449\u0438 \u041C\u0438\u0440\u0443 \u0432\u043D\u0438\u0437\u0443,
      \u0443 \u041F\u0440\u0438\u043C\u0438\u0443\u043C\u0430. \u041E\u043D\u0430
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372933
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
      \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372934
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372935
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372936
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372937
    m_Localized: "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372938
    m_Localized: "\u041F\u043E\u043D\u044F\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372939
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372940
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0442\u044B
      \u0434\u043E\u0448\u0451\u043B. \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0439\u0434\u0438
      RepairManager \u0438 \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u043D\u0435\u043C\u0443.
      \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0442\u043C\u0435\u0442\u0438\u0442
      \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0435, \u043A\u043E\u0433\u0434\u0430
      \u0442\u044B \u043E\u043A\u0430\u0436\u0435\u0448\u044C\u0441\u044F \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372941
    m_Localized: "RepairManager \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u041F\u0440\u0438\u043C\u0438\u0443\u043C\u0435. \u041F\u043E\u0434\u043E\u0439\u0434\u0438
      \u043A \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0440\u0435\u043C\u043E\u043D\u0442\u0430,
      \u0437\u0430\u0442\u0435\u043C \u0432\u0435\u0440\u043D\u0438\u0441\u044C \u043A\u043E
      \u043C\u043D\u0435 \u2014 \u044D\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0448\u0430\u0433\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372942
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u044C
      MarketZone_Primium. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
      \u043A\u043E \u043C\u043D\u0435 \u0437\u0430 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u043E\u0442\u043C\u0435\u0442\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372943
    m_Localized: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0412\u043E\u0442 \u043A\u043B\u044E\u0447 \u043E\u0442 \u043B\u0451\u0433\u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u2014 \u043E\u043D \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372944
    m_Localized: "\u042F \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372945
    m_Localized: "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0443
      RepairManager?"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372946
    m_Localized: "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0432
      MarketZone_Primium?"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372947
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u043A\u043B\u044E\u0447
      \u043E\u0442 \u043B\u0451\u0433\u043A\u043E\u0433\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372948
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u0432\u0435\u0441\u0442-\u0433\u0430\u0439\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372949
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0438 \u0432\u0432\u043E\u0434\u043D\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0435\u0440\u0435\u0437 \u041C\u0438\u0440\u0443,
      RepairManager \u0438 MarketZone_Primium. \u0412 \u043A\u043E\u043D\u0446\u0435
      \u041C\u0438\u0440\u0430 \u0432\u044B\u0434\u0430\u0441\u0442 \u043A\u043B\u044E\u0447
      \u043E\u0442 \u043B\u0451\u0433\u043A\u043E\u0433\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372950
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u041C\u0438\u0440\u0443 \u0438
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0441 \u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372951
    m_Localized: "\u041F\u043E\u0441\u0435\u0442\u0438 RepairManager."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372952
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0441\u044C \u043A \u041C\u0438\u0440\u0435
      \u043F\u043E\u0441\u043B\u0435 RepairManager."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372953
    m_Localized: "\u041F\u043E\u0441\u0435\u0442\u0438 MarketZone_Primium."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372954
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0441\u044C \u043A \u041C\u0438\u0440\u0435
      \u043F\u043E\u0441\u043B\u0435 MarketZone_Primium."
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372955
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u041C\u0438\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372956
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A RepairManager"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372957
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u041C\u0438\u0440\u0435
      \u043F\u043E\u0441\u043B\u0435 RepairManager"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372958
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A MarketZone_Primium"
    m_Metadata:
      m_Items: []
  - m_Id: 3660517909372959
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u041C\u0438\u0440\u0435
      \u043F\u043E\u0441\u043B\u0435 MarketZone_Primium"
    m_Metadata:
      m_Items: []
