/* MainMenuStyles.uss
   Full-screen overlay, centered panel, styled buttons matching EscMenu visual language. */

/* Full-screen background overlay */
.main-menu-root {
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    background-color: rgba(8, 12, 22, 0.92) !important;
    align-items: center !important;
    justify-content: center !important;
}

/* Centered window */
.main-menu-window {
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 420px !important;
    padding: 40px 32px 36px 32px !important;
}

/* Title */
.main-menu-title {
    color: rgb(200, 210, 230) !important;
    font-size: 26px !important;
    -unity-font-style: bold !important;
    -unity-text-align: middle-center !important;
    letter-spacing: 2px !important;
    margin-bottom: 4px !important;
}

/* Subtitle */
.main-menu-subtitle {
    color: rgb(120, 140, 170) !important;
    font-size: 13px !important;
    -unity-text-align: middle-center !important;
    margin-bottom: 32px !important;
}

/* Buttons container */
.main-menu-buttons {
    flex-direction: column !important;
    align-items: stretch !important;
    width: 100% !important;
}

/* Generic button style */
.main-menu-btn {
    color: rgb(220, 220, 220) !important;
    background-color: rgba(40, 50, 70, 0.9) !important;
    border-width: 1px !important;
    border-color: rgb(80, 100, 140) !important;
    border-radius: 4px !important;
    padding: 12px 16px !important;
    margin-bottom: 10px !important;
    -unity-text-align: middle-center !important;
    -unity-font-style: bold !important;
    font-size: 15px !important;
}
.main-menu-btn:hover {
    background-color: rgba(70, 110, 160, 0.95) !important;
    border-color: rgb(140, 180, 240) !important;
}

/* Back / secondary button */
.main-menu-btn-back {
    color: rgb(160, 180, 210) !important;
    background-color: rgba(30, 40, 60, 0.9) !important;
    border-color: rgba(80, 100, 140, 0.6) !important;
}
.main-menu-btn-back:hover {
    background-color: rgba(50, 60, 85, 0.9) !important;
    border-color: rgb(120, 150, 200) !important;
    color: rgb(210, 225, 250) !important;
}

/* Warning / quit button */
.main-menu-btn-warning {
    color: rgb(240, 180, 140) !important;
    border-color: rgb(160, 100, 60) !important;
}
.main-menu-btn-warning:hover {
    background-color: rgba(180, 80, 40, 0.85) !important;
    border-color: rgb(240, 140, 80) !important;
    color: rgb(255, 210, 180) !important;
}

/* IP Connect Panel */
.main-ip-panel {
    flex-direction: column !important;
    align-items: center !important;
    width: 100% !important;
}

.main-ip-label {
    color: rgb(180, 190, 210) !important;
    font-size: 14px !important;
    -unity-text-align: middle-center !important;
    margin-bottom: 12px !important;
    margin-top: 20px !important;
}

.main-ip-field {
    width: 260px !important;
    margin-bottom: 20px !important;
}
.main-ip-field .unity-base-text-field__label {
    display: none !important;
}
.main-ip-field .unity-base-text-field__input {
    background-color: rgba(20, 30, 50, 0.95) !important;
    color: rgb(220, 220, 220) !important;
    border-width: 1px !important;
    border-color: rgb(80, 100, 140) !important;
    border-radius: 4px !important;
    padding: 8px 12px !important;
    font-size: 15px !important;
    -unity-text-align: middle-center !important;
}

.main-ip-buttons {
    flex-direction: row !important;
    justify-content: center !important;
    width: 100% !important;
}
.main-ip-buttons .main-menu-btn {
    width: 160px !important;
    margin-left: 6px !important;
    margin-right: 6px !important;
}

/* ===== Language selector (top-right corner) ===== */
.main-lang-selector {
    position: absolute !important;
    top: 14px !important;
    right: 16px !important;
    width: 150px !important;
}

.main-lang-selector .custom-dropdown__button {
    background-color: rgba(40, 50, 70, 0.9) !important;
    border-width: 1px !important;
    border-color: rgb(80, 100, 140) !important;
    border-radius: 4px !important;
    padding: 6px 10px !important;
    min-height: 30px !important;
    flex-direction: row !important;
    align-items: center !important;
}

.main-lang-selector .custom-dropdown__button:hover {
    border-color: rgb(120, 160, 220) !important;
    background-color: rgba(50, 65, 90, 0.95) !important;
}

.main-lang-selector .custom-dropdown__text {
    color: rgb(210, 220, 235) !important;
    font-size: 13px !important;
    flex-grow: 1 !important;
    -unity-text-align: middle-left !important;
}

.main-lang-selector .custom-dropdown__arrow {
    color: rgb(140, 160, 200) !important;
    font-size: 10px !important;
    margin-left: 8px !important;
}
