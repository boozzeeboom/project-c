// LocalDensity.compute — Phase 2.1
// Toroidal 3D density buffer: wind advection + Gaussian splat application.
// Ping-pong: _DensityPrev → AdvectAndRelax → _DensityNext + ApplySplats.
// Toroidal addressing: window follows player, no data copy (snowflow pattern).

#pragma kernel AdvectAndRelax
#pragma kernel ApplySplats
#pragma kernel AdvectAndRelax_Disp
#pragma kernel ApplySplats_Disp
#pragma kernel ClearDensity
#pragma kernel ClearDisp
#pragma target 5.0

// ── Input / Output ──
RWTexture3D<float> _DensityPrev;   // read from previous frame (density mode)
RWTexture3D<float> _DensityNext;   // write into current frame (density mode)

// ── Displacement mode (RGBAHalf: RGB=displacement vector, A=unused) ──
RWTexture3D<float4> _DensityPrevDisp;  // read from previous frame (displacement mode)
RWTexture3D<float4> _DensityNextDisp;  // write into current frame (displacement mode)

// ── Toroidal Window ──
float3 _Center;                    // world-space center of the toroidal window
float  _TexelSize;                 // world units per texel
uint   _Resolution;                // texture resolution (e.g. 96)

// ── Advection ──
float3 _WindDirection;             // normalized
float  _AdvectionStrength;         // how strongly wind moves the field
float  _RelaxationRate;            // relaxation per second
float  _DeltaTime;                 // frame delta time

// ── Splats ──
struct SplatData
{
    float3 center;
    float  radius;
    float  amount;
};
StructuredBuffer<SplatData> _Splats;
uint _SplatCount;

// ── Helper: worldPos → toroidal UVW ──
// Torus: uvw = (worldPos - Center) / (Resolution * TexelSize) + 0.5; uvw = frac(uvw);
float3 WorldToToroidalUvw(float3 worldPos)
{
    float windowSize = (float)_Resolution * _TexelSize;
    float3 uvw = (worldPos - _Center) / windowSize + 0.5;
    return frac(uvw);
}

float3 ToroidalUvwToWorld(float3 uvw)
{
    float windowSize = (float)_Resolution * _TexelSize;
    return _Center + (uvw - 0.5) * windowSize;
}

// ─────────────────────────────────────────────────
// Kernel: AdvectAndRelax
// Reads _DensityPrev, applies wind advection + relaxation, writes _DensityNext
// ─────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void AdvectAndRelax(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution)
        return;

    // Normalized UVW for this cell [0..1]
    float3 uvw = (float3(id) + 0.5) / (float)_Resolution;

    // World position of this cell
    float3 worldPos = ToroidalUvwToWorld(uvw);

    // Wind offset in texel units
    // windOffset = WindDirection * AdvectionStrength * DeltaTime (world units)
    // convert world offset to UVW offset: worldOffset / windowSize
    float windowSize = (float)_Resolution * _TexelSize;
    float3 windWorldOffset = _WindDirection * _AdvectionStrength * _DeltaTime;
    float3 windUvwOffset = windWorldOffset / windowSize;

    // Sample previous frame with wind advection (toroidal wrap via frac)
    float3 sampleUvw = frac(uvw + windUvwOffset);
    float3 sampleTexel = sampleUvw * (float)_Resolution;
    sampleTexel = clamp(sampleTexel, 0.0, (float)_Resolution - 1.0);
    float sample = _DensityPrev[uint3(sampleTexel)];

    // Relaxation: exponential decay toward zero
    float relaxed = max(0.0, sample - _RelaxationRate * _DeltaTime);

    _DensityNext[id] = relaxed;
}

// ─────────────────────────────────────────────────
// Kernel: ApplySplats
// Reads _DensityNext (already contains advected+relaxed data from previous kernel),
// applies all Gaussian splats idempotently, writes back.
// ─────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void ApplySplats(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution)
        return;

    float density = _DensityNext[id];

    float3 uvw = (float3(id) + 0.5) / (float)_Resolution;
    float3 worldPos = ToroidalUvwToWorld(uvw);

    // Accumulate all splats for this cell
    for (uint i = 0; i < _SplatCount; i++)
    {
        SplatData splat = _Splats[i];
        float d = length(worldPos - splat.center);
        // Toroidal wrap: also check the closest periodic copy
        float windowSize = (float)_Resolution * _TexelSize;
        // For each dimension, check ±windowSize offset
        float3 offsets[6] = {
            float3(-windowSize, 0, 0), float3(windowSize, 0, 0),
            float3(0, -windowSize, 0), float3(0, windowSize, 0),
            float3(0, 0, -windowSize), float3(0, 0, windowSize)
        };
        float minDist = d;
        for (uint j = 0; j < 6; j++)
        {
            float distJ = length(worldPos + offsets[j] - splat.center);
            minDist = min(minDist, distJ);
        }

        // Gaussian falloff: exp(-d² / (2 * σ²)) where σ = radius/3
        float sigma = splat.radius * 0.33333;
        float gauss = exp(-(minDist * minDist) / max(2.0 * sigma * sigma, 0.001));
        density += splat.amount * gauss;
    }

    _DensityNext[id] = max(0.0, density);
}

// ─────────────────────────────────────────────────
// Kernel: AdvectAndRelax_Disp  (Variant B: displacement)
// Reads _DensityPrevDisp, applies wind advection + multiplicative relaxation,
// writes _DensityNextDisp.
// ─────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void AdvectAndRelax_Disp(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution)
        return;

    float3 uvw = (float3(id) + 0.5) / (float)_Resolution;
    float windowSize = (float)_Resolution * _TexelSize;
    float3 windWorldOffset = _WindDirection * _AdvectionStrength * _DeltaTime;
    float3 windUvwOffset = windWorldOffset / windowSize;

    float3 sampleUvw = frac(uvw + windUvwOffset);
    float3 sampleTexel = sampleUvw * (float)_Resolution;
    sampleTexel = clamp(sampleTexel, 0.0, (float)_Resolution - 1.0);
    float4 prev = _DensityPrevDisp[uint3(sampleTexel)];

    // Multiplicative decay toward zero (preserves direction, shrinks magnitude)
    float decay = max(0.0, 1.0 - _RelaxationRate * _DeltaTime);
    float4 relaxed = prev * decay;

    _DensityNextDisp[id] = relaxed;
}

// ─────────────────────────────────────────────────
// Kernel: ApplySplats_Disp  (Variant B: displacement)
// Reads _DensityNextDisp (already advected+relaxed),
// accumulates displacement vectors: push AWAY from each splat center.
// ─────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void ApplySplats_Disp(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution)
        return;

    float4 current = _DensityNextDisp[id];
    float3 displacement = current.rgb;

    float3 uvw = (float3(id) + 0.5) / (float)_Resolution;
    float3 worldPos = ToroidalUvwToWorld(uvw);
    float windowSize = (float)_Resolution * _TexelSize;

    for (uint i = 0; i < _SplatCount; i++)
    {
        SplatData splat = _Splats[i];
        float3 toCell = worldPos - splat.center;
        float d = length(toCell);

        // Toroidal wrap: check closest periodic copy of splat center
        float3 offsets[6] = {
            float3(-windowSize, 0, 0), float3(windowSize, 0, 0),
            float3(0, -windowSize, 0), float3(0, windowSize, 0),
            float3(0, 0, -windowSize), float3(0, 0, windowSize)
        };
        float minDist = d;
        float3 bestToCell = toCell;
        for (uint j = 0; j < 6; j++)
        {
            float3 altToCell = worldPos + offsets[j] - splat.center;
            float distJ = length(altToCell);
            if (distJ < minDist)
            {
                minDist = distJ;
                bestToCell = altToCell;
            }
        }

        float sigma = splat.radius * 0.33333;
        float gauss = exp(-(minDist * minDist) / max(2.0 * sigma * sigma, 0.001));

        // Radial push: direction FROM splat center TO cell
        float3 pushDir = normalize(bestToCell + 0.0001);
        displacement += pushDir * splat.amount * gauss;
    }

    _DensityNextDisp[id] = float4(displacement, 0);
}

// ─────────────────────────────────────────────────
// Clear kernels — must use compute for 3D UAV RTs
// (GL.Clear does NOT work on enableRandomWrite 3D textures)
// ─────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void ClearDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution) return;
    _DensityNext[id] = 0;
}

[numthreads(8, 8, 8)]
void ClearDisp(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution) return;
    _DensityNextDisp[id] = float4(0, 0, 0, 0);
}
